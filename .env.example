# ==============================================================================
# Variables de Entorno - Nube Privada de Camila (Plantilla de Configuración)
# ==============================================================================
# IMPORTANTE: Ejecuta 'python tools/generate_secrets.py' para generar valores seguros.

# 1. Contraseña maestra de acceso a la bóveda (Mínimo 12 caracteres, fail-closed)
ACCESS_PASSWORD=CAMBIA_ESTA_CONTRASENA_POR_UNA_SEGURA_MIN_12_CHARS

# 2. Clave secreta para firma criptográfica HMAC-SHA256 (Mínimo 32 caracteres hex / 256 bits)
SECRET_KEY=CAMBIA_ESTA_CLAVE_HEX_256BITS_GENERA_CON_generate_secrets_py

# 3. ID de la carpeta compartida en Google Drive (Requerido)
DRIVE_FOLDER_ID=1JNTRutM6sp-c9dstsSuITgpTMzEc4WSm

# 4. Orígenes CORS permitidos (* o URLs separadas por coma, e.g. https://camila.vercel.app)
CORS_ORIGINS=*

# 5. Puerto y Host local
PORT=8000
HOST=127.0.0.1

# 6. Para Render / Railway en Producción:
# (Pega aquí el contenido de credentials.json en una sola línea en las variables de Render)
# GOOGLE_CREDENTIALS_JSON=
